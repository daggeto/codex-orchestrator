{
  "name": "orchestrator-monitor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "\"$npm_node_execpath\" node_modules/vite/bin/vite.js",
    "preview": "\"$npm_node_execpath\" node_modules/vite/bin/vite.js preview",
    "typecheck": "\"$npm_node_execpath\" node_modules/typescript/bin/tsc --noEmit",
    "build": "\"$npm_node_execpath\" node_modules/typescript/bin/tsc --noEmit && \"$npm_node_execpath\" node_modules/vite/bin/vite.js build",
    "test": "\"$npm_node_execpath\" node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
